{
  "name": "prism-variant-images",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "shopify app dev",
    "dev:web": "node scripts/dev-web.mjs",
    "build": "npm run build:storefront && npm run build:admin && npm run build:server",
    "build:admin": "vite build",
    "build:storefront": "node scripts/build-storefront.mjs",
    "build:server": "esbuild src/server/node.ts --bundle --platform=node --format=esm --target=node20 --outfile=build/server.mjs --log-level=warning",
    "setup": "node -e \"\"",
    "start": "node build/server.mjs",
    "deploy": "node scripts/check-app-url.mjs && npm run build:storefront && shopify app deploy",
    "deploy:worker": "npm run build && wrangler deploy",
    "config:link": "shopify app config link",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p extensions/product-block/tsconfig.json && tsc --noEmit -p extensions/bulk-action/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "harness": "node scripts/harness.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@preact/preset-vite": "^2.10.6",
    "esbuild": "^0.28.2",
    "preact": "^10.29.8",
    "vite": "^8.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260929.1",
    "@shopify/app-bridge-types": "^0.7.2",
    "@shopify/polaris-types": "^1.1.0",
    "happy-dom": "^20.14.5",
    "liquidjs": "^10.29.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.2",
    "wrangler": "^4.143.0"
  },
  "workspaces": [
    "extensions/*"
  ]
}
