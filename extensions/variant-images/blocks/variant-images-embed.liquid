{%- comment -%}
  Prism Variant Images — app embed (renders in <head>).

  Everything the storefront needs is rendered here from Shopify data:
  - shop settings:   app-data metafield  app.metafields.variant_images.settings
  - product config:  app-owned metafield product.metafields["$app:variant_images"].data
  The scripts never call an app server, so there is no per-visitor cost.
{%- endcomment -%}
{%- liquid
  assign pvi_settings = app.metafields.variant_images.settings.value

  assign pvi_gallery_on = true
  if pvi_settings.gallery.enabled == false
    assign pvi_gallery_on = false
  endif
  assign pvi_swatches_on = false
  if pvi_settings.swatches.enabled == true
    assign pvi_swatches_on = true
  endif
  assign pvi_cards_on = false
  if pvi_settings.cards.enabled == true
    assign pvi_cards_on = true
  endif

  assign pvi_is_product = false
  if template.name == 'product' and product != blank
    assign pvi_is_product = true
  endif

  assign pvi_config = nil
  assign pvi_has_config = false
  if pvi_is_product
    assign pvi_config = product.metafields['$app:variant_images'].data.value
    if pvi_config.g != blank
      assign pvi_has_config = true
    endif
  endif

  assign pvi_filter = false
  if pvi_has_config and pvi_gallery_on
    assign pvi_filter = true
  endif

  assign pvi_product_script = false
  if pvi_filter
    assign pvi_product_script = true
  elsif pvi_is_product and pvi_swatches_on
    assign pvi_product_script = true
  endif

  assign pvi_cards_script = false
  if pvi_cards_on
    case template.name
      when 'index', 'collection', 'search', 'product', 'page', 'list-collections', 'blog', 'article'
        assign pvi_cards_script = true
    endcase
  endif
-%}
{%- if pvi_product_script or pvi_cards_script -%}
  <style id="pvi-base">[data-pvi-hidden],[data-pvi-native-hidden]{display:none!important}</style>
  <script type="application/json" id="pvi-settings">{{ pvi_settings | json }}</script>
  {%- if pvi_settings.customCss != blank -%}
    <style id="pvi-custom">{{ pvi_settings.customCss | remove: '<' }}</style>
  {%- endif -%}
{%- endif -%}

{%- if pvi_product_script -%}
  <script type="application/json" id="pvi-i18n">{"soldOut":{{ 'swatches.sold_out' | t | json }},"unavailable":{{ 'swatches.unavailable' | t | json }}}</script>
  <script type="application/json" id="pvi-product">
    {
      "id": {{ product.id }},
      "handle": {{ product.handle | json }},
      "url": {{ product.url | json }},
      "selected": {{ product.selected_variant.id | default: 'null' }},
      "first": {{ product.selected_or_first_available_variant.id | default: 'null' }},
      "config": {{ pvi_config | json }},
      "options": [
        {%- for option in product.options_with_values -%}
          {%- unless forloop.first -%},{%- endunless -%}
          {"name": {{ option.name | json }}, "position": {{ option.position }}, "values": [
            {%- for value in option.values -%}
              {%- unless forloop.first -%},{%- endunless -%}
              {"id": {{ value.id }}, "name": {{ value.name | json }}
              {%- if value.swatch.color -%}, "color": "rgb({{ value.swatch.color.rgb }})"{%- endif -%}
              {%- if value.swatch.image -%}, "image": {{ value.swatch.image | image_url: width: 120 | json }}{%- endif -%}
              }
            {%- endfor -%}
          ]}
        {%- endfor -%}
      ],
      "variants": [
        {%- for v in product.variants -%}
          {%- unless forloop.first -%},{%- endunless -%}
          [{{ v.id }},{% if v.available %}1{% else %}0{% endif %},{{ v.option1 | json }},{{ v.option2 | json }},{{ v.option3 | json }},{{ v.featured_media.id | default: 'null' }}]
        {%- endfor -%}
      ],
      "media": [
        {%- for m in product.media -%}
          {%- unless forloop.first -%},{%- endunless -%}
          {"id": {{ m.id }}, "type": {{ m.media_type | json }}, "src": {{ m.preview_image.src | json }}, "thumb": {% if m.preview_image %}{{ m.preview_image | image_url: width: 160 | json }}{% else %}null{% endif %}}
        {%- endfor -%}
      ],
      "images": [
        {%- for img in product.images -%}
          {%- unless forloop.first -%},{%- endunless -%}
          [{{ img.id }}, {{ img.src | json }}]
        {%- endfor -%}
      ]
    }
  </script>

  {%- comment -%}
    Anti-flicker: hide other variants' media before the script runs, for
    galleries whose items carry the media id (Dawn family, Horizon and many
    OS 2.0 themes). The script replaces this with exact per-theme hiding.
  {%- endcomment -%}
  {%- liquid
    assign pvi_prehide = false
    if pvi_filter and pvi_settings.gallery.preventFlash != false
      assign pvi_prehide = true
      if product.selected_variant == blank and pvi_settings.gallery.noSelection == 'all'
        assign pvi_prehide = false
      endif
    endif
  -%}
  {%- if pvi_prehide -%}
    {%- liquid
      assign pvi_sel = ','
      for option in product.options_with_values
        for value in option.values
          if value.selected
            assign pvi_sel = pvi_sel | append: value.id | append: ','
          endif
        endfor
      endfor

      assign pvi_best_size = 0
      assign pvi_best = ','
      assign pvi_assigned = ','
      for pair in pvi_config.g
        assign pvi_ids = pair[0] | split: '.'
        assign pvi_media_list = pair[1] | join: ','
        assign pvi_assigned = pvi_assigned | append: pvi_media_list | append: ','
        assign pvi_match = true
        for pvi_id in pvi_ids
          assign pvi_needle = ',' | append: pvi_id | append: ','
          unless pvi_sel contains pvi_needle
            assign pvi_match = false
            break
          endunless
        endfor
        if pvi_match
          if pvi_ids.size > pvi_best_size
            assign pvi_best_size = pvi_ids.size
            assign pvi_best = ','
          endif
          if pvi_ids.size == pvi_best_size
            assign pvi_best = pvi_best | append: pvi_media_list | append: ','
          endif
        endif
      endfor

      assign pvi_shared = ','
      if pvi_config.s != blank
        assign pvi_shared = pvi_config.s | join: ',' | prepend: ',' | append: ','
      endif

      assign pvi_hide_unassigned = false
      if pvi_config.h == 1
        assign pvi_hide_unassigned = true
      elsif pvi_config.h == nil and pvi_settings.gallery.hideUnassigned == true
        assign pvi_hide_unassigned = true
      endif

      assign pvi_hidden = ''
      assign pvi_visible_count = 0
      for m in product.media
        assign pvi_needle = ',' | append: m.id | append: ','
        assign pvi_show = false
        if pvi_best contains pvi_needle or pvi_shared contains pvi_needle
          assign pvi_show = true
        else
          unless pvi_assigned contains pvi_needle or pvi_hide_unassigned
            assign pvi_show = true
          endunless
        endif
        if pvi_show
          assign pvi_visible_count = pvi_visible_count | plus: 1
        else
          assign pvi_hidden = pvi_hidden | append: m.id | append: ','
        endif
      endfor
    -%}
    {%- if pvi_visible_count > 0 and pvi_hidden != blank -%}
      {%- liquid
        assign pvi_hidden_ids = pvi_hidden | split: ','
        assign pvi_attr = ''
        assign pvi_has = ''
        for id in pvi_hidden_ids
          unless forloop.first
            assign pvi_attr = pvi_attr | append: ','
            assign pvi_has = pvi_has | append: ','
          endunless
          assign pvi_attr = pvi_attr | append: '[data-media-id="' | append: id | append: '"],[data-media-id$="-' | append: id | append: '"],[data-target$="-' | append: id | append: '"],[data-media-item-id="' | append: id | append: '"]'
          assign pvi_has = pvi_has | append: '[data-media-id="' | append: id | append: '"]'
        endfor
      -%}
      {%- comment -%}
        Item patterns from popular themes (Dawn family, Horizon, Prestige/Impact,
        Symmetry, Swiper-based themes). Two rules so browsers without :has()
        still apply the first one.
      {%- endcomment -%}
      <style id="pvi-prehide">
        :is(li,.swiper-slide,[class*="media-item"],.product-gallery__media,.product-gallery__thumbnail,.slider__item,.product-media-collage__item):is({{ pvi_attr }}){display:none!important}
        :is(.swiper-slide,slideshow-slide,.media-gallery__grid>li):has(:is({{ pvi_has }})){display:none!important}
      </style>
      <script>setTimeout(function(){if(!window.__pviProduct){var s=document.getElementById('pvi-prehide');if(s)s.remove();}},4000);</script>
    {%- endif -%}
  {%- endif -%}
  <script src="{{ 'pvi-product.js' | asset_url }}" defer></script>
  {%- if pvi_swatches_on -%}
    <script src="{{ 'pvi-swatches.js' | asset_url }}" defer></script>
  {%- endif -%}
{%- endif -%}

{%- if pvi_cards_script -%}
  <script src="{{ 'pvi-cards.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "Variant images",
  "target": "head",
  "settings": [
    {
      "type": "paragraph",
      "content": "Assign images to variants and style swatches in the app. This embed must stay on for variant images to work."
    }
  ]
}
{% endschema %}
