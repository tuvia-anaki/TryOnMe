{%- comment -%}
  The app's product grid: products (optionally split into one card per
  color, like on collection pages) in a grid or a carousel.
  - products, s (block settings), block, view_all_url
{%- endcomment -%}
{%- liquid
  assign vc = app.metafields.variant_cards.settings.value
  assign title_template = vc.split.title | default: '{product} - {value}'
  assign color_words = 'color,colour,colors,colours,colorway,shade,farbe,farben,couleur,couleurs,colore,colori,cor,cores,kleur,kleuren,färg,farge,farve,väri,kolor,barva,renk,culoare,szín,цвет,колір,צבע,لون,رنگ,颜色,顏色,カラー,色,색상,สี' | split: ','
  assign limit = s.limit | default: 8
  assign carousel = false
  if s.layout == 'carousel'
    assign carousel = true
  endif
  assign count = 0
-%}
<div
  class="vc-section vc-align--{{ s.text_align | default: 'left' }} vc-radius--{{ s.corner_radius | default: 'small' }} vc-button--{{ s.button_style | default: 'outline' }}"
  data-vc-section
  data-text-add="{{ 'texts.add_to_cart' | t | escape }}"
  data-text-added="{{ 'texts.added' | t | escape }}"
  data-text-view-cart="{{ 'texts.view_cart' | t | escape }}"
  data-text-sold-out="{{ 'texts.sold_out' | t | escape }}"
  style="--vc-cols: {{ s.columns_desktop | default: 4 }}; --vc-cols-t: {{ s.columns_desktop | default: 4 | at_most: 3 }}; --vc-cols-m: {{ s.columns_mobile | default: 2 }};{% if s.accent_color != blank %} --vc-accent: {{ s.accent_color }};{% endif %}"
>
  {%- if s.heading != blank or s.subheading != blank or view_all_url != blank -%}
    <div class="vc-section__header">
      <div>
        {%- if s.heading != blank -%}
          <h2 class="vc-section__heading">{{ s.heading }}</h2>
        {%- endif -%}
        {%- if s.subheading != blank -%}
          <p class="vc-section__sub">{{ s.subheading }}</p>
        {%- endif -%}
      </div>
      {%- if view_all_url != blank -%}
        <a class="vc-section__all" href="{{ view_all_url }}">{{ 'texts.view_all' | t }}</a>
      {%- endif -%}
    </div>
  {%- endif -%}
  <div class="vc-section__body{% if carousel %} is-carousel{% endif %}"{% if carousel %} data-vc-carousel{% endif %}>
    {%- if carousel -%}
      <button type="button" class="vc-arrow vc-arrow--prev" data-vc-prev aria-label="{{ 'texts.previous' | t | escape }}"><span aria-hidden="true">‹</span></button>
    {%- endif -%}
    <div class="vc-grid" role="list">
      {%- for product in products -%}
        {%- if count >= limit -%}{%- break -%}{%- endif -%}
        {%- liquid
          assign split_option = nil
          if s.split and product.has_only_default_variant == false
            for option in product.options_with_values
              assign option_name = option.name | downcase | strip
              if color_words contains option_name and option.values.size > 1
                assign split_option = option
                break
              endif
            endfor
          endif
        -%}
        {%- if split_option -%}
          {%- assign split_key = 'option' | append: split_option.position -%}
          {%- for value in split_option.values -%}
            {%- if count >= limit -%}{%- break -%}{%- endif -%}
            {%- liquid
              assign group = product.variants | where: split_key, value.name
              assign rep = group | where: 'available', true | first
              unless rep
                assign rep = group | first
              endunless
            -%}
            {%- if rep == blank -%}{%- continue -%}{%- endif -%}
            {%- if s.hide_sold_out and rep.available == false -%}{%- continue -%}{%- endif -%}
            {%- liquid
              assign title = title_template | replace: '{product.title}', product.title | replace: '{product}', product.title | replace: '{value}', value.name | replace: '{variant.title}', rep.title | replace: '{variant}', rep.title | replace: '{option1}', rep.option1 | replace: '{option2}', rep.option2 | replace: '{option3}', rep.option3 | replace: '{vendor}', product.vendor | replace: '{type}', product.type | strip
            -%}
            {%- render 'vc-card', product: product, variant: rep, title: title, split_key: split_key, s: s -%}
            {%- assign count = count | plus: 1 -%}
          {%- endfor -%}
        {%- else -%}
          {%- if s.hide_sold_out and product.available == false -%}{%- continue -%}{%- endif -%}
          {%- render 'vc-card', product: product, variant: nil, title: product.title, split_key: nil, s: s -%}
          {%- assign count = count | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if count == 0 and request.design_mode -%}
        {%- for i in (1..4) -%}
          <div class="vc-card vc-card--placeholder" role="listitem">
            <span class="vc-card__media vc-ratio--{{ s.image_ratio | default: 'square' }}">{{- 'product-apparel-1' | placeholder_svg_tag: 'vc-card__img vc-card__placeholder' -}}</span>
            <div class="vc-card__info">
              <span class="vc-card__title">{{ 'texts.example_product' | t }}</span>
              <p class="vc-card__price">{{ 1999 | money }}</p>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
    {%- if carousel -%}
      <button type="button" class="vc-arrow vc-arrow--next" data-vc-next aria-label="{{ 'texts.next' | t | escape }}"><span aria-hidden="true">›</span></button>
    {%- endif -%}
  </div>
</div>
