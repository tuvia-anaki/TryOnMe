{%- comment -%}
  Related products from Shopify's product recommendations. The block renders
  a placeholder; vc-sections.js asks Shopify for this same section with
  recommendations filled in and swaps it in.
{%- endcomment -%}
{%- if product -%}
  <div class="vc-block" {{ block.shopify_attributes }}>
    {%- if recommendations.performed? -%}
      <div data-vc-related="{{ block.id }}">
        {%- if recommendations.products_count > 0 -%}
          {%- render 'vc-grid', products: recommendations.products, s: block.settings, block: block, view_all_url: '' -%}
        {%- endif -%}
      </div>
    {%- else -%}
      <div
        data-vc-related="{{ block.id }}"
        data-vc-related-url="{{ routes.product_recommendations_url }}?product_id={{ product.id }}&limit={{ block.settings.limit }}&section_id={{ section.id }}&intent={{ block.settings.intent }}"
        {% unless request.design_mode %}hidden{% endunless %}
      >
        {%- if request.design_mode -%}
          {%- render 'vc-grid', products: collections.all.products, s: block.settings, block: block, view_all_url: '' -%}
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Related products",
  "target": "section",
  "javascript": "vc-sections.js",
  "stylesheet": "vc-sections.css",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also like"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "select",
      "id": "intent",
      "label": "Recommendations",
      "default": "related",
      "options": [
        {
          "value": "related",
          "label": "Related products"
        },
        {
          "value": "complementary",
          "label": "Complementary products"
        }
      ],
      "info": "Shopify picks them automatically. Complementary products are set in the Search & Discovery app."
    },
    {
      "type": "range",
      "id": "limit",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 4,
      "label": "Cards to show"
    },
    {
      "type": "checkbox",
      "id": "split",
      "label": "Show each color as its own card",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hide_sold_out",
      "label": "Hide sold-out cards",
      "default": false
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "grid",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "carousel",
          "label": "Carousel"
        }
      ]
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "Columns on desktop"
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 2,
      "step": 1,
      "default": 2,
      "label": "Columns on mobile"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "header",
      "content": "Cards"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "default": "portrait",
      "options": [
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "landscape",
          "label": "Landscape"
        },
        {
          "value": "natural",
          "label": "Original"
        }
      ]
    },
    {
      "type": "select",
      "id": "corner_radius",
      "label": "Corners",
      "default": "small",
      "options": [
        {
          "value": "none",
          "label": "Square"
        },
        {
          "value": "small",
          "label": "Slightly rounded"
        },
        {
          "value": "large",
          "label": "Rounded"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_second_image",
      "label": "Show second image on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_swatches",
      "label": "Show color swatches",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_add_to_cart",
      "label": "Show add to cart button",
      "default": true
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "default": "outline",
      "options": [
        {
          "value": "outline",
          "label": "Outline"
        },
        {
          "value": "solid",
          "label": "Solid"
        }
      ]
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "info": "Sale badges and solid buttons. Leave empty to use your theme's text color."
    }
  ],
  "enabled_on": {
    "templates": [
      "product"
    ]
  }
}
{% endschema %}
