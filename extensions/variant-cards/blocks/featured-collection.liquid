{%- comment -%} Featured collection: a collection's products as variant cards. {%- endcomment -%}
{%- liquid
  assign source = block.settings.collection
  assign view_all_url = ''
  if source and block.settings.show_view_all
    assign view_all_url = source.url
  endif
-%}
<div class="vc-block" {{ block.shopify_attributes }}>
  {%- if source -%}
    {%- render 'vc-grid', products: source.products, s: block.settings, block: block, view_all_url: view_all_url -%}
  {%- else -%}
    {%- render 'vc-grid', products: collections.all.products, s: block.settings, block: block, view_all_url: '' -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Featured collection",
  "target": "section",
  "javascript": "vc-sections.js",
  "stylesheet": "vc-sections.css",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop the collection"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show \"View all\" link",
      "default": true
    },
    {
      "type": "range",
      "id": "limit",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 8,
      "label": "Cards to show"
    },
    {
      "type": "checkbox",
      "id": "split",
      "label": "Show each color as its own card",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hide_sold_out",
      "label": "Hide sold-out cards",
      "default": false
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "grid",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "carousel",
          "label": "Carousel"
        }
      ]
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "Columns on desktop"
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 2,
      "step": 1,
      "default": 2,
      "label": "Columns on mobile"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "header",
      "content": "Cards"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "default": "portrait",
      "options": [
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "landscape",
          "label": "Landscape"
        },
        {
          "value": "natural",
          "label": "Original"
        }
      ]
    },
    {
      "type": "select",
      "id": "corner_radius",
      "label": "Corners",
      "default": "small",
      "options": [
        {
          "value": "none",
          "label": "Square"
        },
        {
          "value": "small",
          "label": "Slightly rounded"
        },
        {
          "value": "large",
          "label": "Rounded"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_second_image",
      "label": "Show second image on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_swatches",
      "label": "Show color swatches",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_add_to_cart",
      "label": "Show add to cart button",
      "default": true
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "default": "outline",
      "options": [
        {
          "value": "outline",
          "label": "Outline"
        },
        {
          "value": "solid",
          "label": "Solid"
        }
      ]
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "info": "Sale badges and solid buttons. Leave empty to use your theme's text color."
    }
  ]
}
{% endschema %}
