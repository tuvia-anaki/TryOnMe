{%- comment -%}
  Promo card: an image tile placed inside the collection grid at the chosen
  position (vc-cards.js moves it there). Without the script it shows as a
  banner where the block sits.
{%- endcomment -%}
{%- liquid
  assign s = block.settings
  assign here = ''
  if collection
    assign here = collection.handle
  endif
-%}
<div class="vc-block vc-promo-section" data-vc-promo-section {{ block.shopify_attributes }}>
  <div
    class="vc-promo vc-promo--{{ s.content_position }} vc-radius--{{ s.corner_radius }}"
    data-vc-promo
    data-position="{{ s.position }}"
    data-span="{{ s.span }}"
    data-collections="{{ s.collections | escape }}"
    data-here="{{ here | escape }}"
    style="--vc-promo-text: {{ s.text_color }}; --vc-promo-overlay: {{ s.overlay | divided_by: 100.0 }};"
  >
    {%- if s.link != blank -%}<a class="vc-promo__inner" href="{{ s.link }}">{%- else -%}<div class="vc-promo__inner">{%- endif -%}
      {%- if s.image -%}
        {{- s.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '400,600,800,1000,1400', sizes: '(min-width: 990px) 50vw, 100vw', class: 'vc-promo__img', alt: s.image.alt | default: s.heading -}}
      {%- else -%}
        {{- 'lifestyle-1' | placeholder_svg_tag: 'vc-promo__img vc-card__placeholder' -}}
      {%- endif -%}
      <span class="vc-promo__content">
        {%- if s.heading != blank -%}<span class="vc-promo__heading">{{ s.heading }}</span>{%- endif -%}
        {%- if s.text != blank -%}<span class="vc-promo__text">{{ s.text }}</span>{%- endif -%}
        {%- if s.button_label != blank -%}<span class="vc-promo__button">{{ s.button_label }}</span>{%- endif -%}
      </span>
    {%- if s.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Promo card",
  "target": "section",
  "javascript": "vc-promo.js",
  "stylesheet": "vc-sections.css",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New season"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Discover this week's arrivals"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Placement"
    },
    {
      "type": "range",
      "id": "position",
      "min": 1,
      "max": 48,
      "step": 1,
      "default": 3,
      "label": "Position in the grid"
    },
    {
      "type": "select",
      "id": "span",
      "label": "Width",
      "default": "1",
      "options": [
        {
          "value": "1",
          "label": "One card"
        },
        {
          "value": "2",
          "label": "Two cards"
        }
      ]
    },
    {
      "type": "text",
      "id": "collections",
      "label": "Only in these collections",
      "info": "Collection handles separated by commas, like summer, sale. Leave empty for every collection."
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Text position",
      "default": "bottom",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ]
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 25,
      "label": "Image darkening"
    },
    {
      "type": "select",
      "id": "corner_radius",
      "label": "Corners",
      "default": "small",
      "options": [
        {
          "value": "none",
          "label": "Square"
        },
        {
          "value": "small",
          "label": "Slightly rounded"
        },
        {
          "value": "large",
          "label": "Rounded"
        }
      ]
    }
  ],
  "enabled_on": {
    "templates": [
      "collection",
      "search"
    ]
  }
}
{% endschema %}
