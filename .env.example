# Only needed for production builds outside `shopify app dev` (which sets these for you).

# Your app's client id (public). Injected into index.html for App Bridge.
# Production builds read it from shopify.app.toml; this is only a fallback.
SHOPIFY_API_KEY=

# Optional: support email shown on the Help page.
VITE_SUPPORT_EMAIL=

# The API secret is NOT used by the build. Set it only on the host that serves
# the admin (Render: Environment → SHOPIFY_API_SECRET; Cloudflare:
#   npx wrangler secret put SHOPIFY_API_SECRET)
